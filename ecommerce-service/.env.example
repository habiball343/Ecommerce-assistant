# ===== E-commerce Service (port 8001) =====
# Default: zero-dependency local mode (SQLite file under ./data)
ECOM_DATABASE_URL=sqlite:///./data/ecommerce.db
# Standard stack: PostgreSQL (start-docker.bat injects this automatically)
# ECOM_DATABASE_URL=postgresql+psycopg://customer_service:customer_service@127.0.0.1:5432/ecommerce

# Must be identical in all three backend services
JWT_SECRET=ecommerce-secret
JWT_ALGORITHM=HS256

API_HOST=127.0.0.1
API_PORT=8001
