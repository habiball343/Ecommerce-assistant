# ===== AI Service (port 8002) =====
# Default: zero-dependency local mode (SQLite file under ./data)
AI_DATABASE_URL=sqlite+aiosqlite:///./data/ai_service.db
# Standard stack: PostgreSQL (start-docker.bat injects this automatically)
# AI_DATABASE_URL=postgresql+psycopg://customer_service:customer_service@127.0.0.1:5432/ai_customer_service

# Must be identical in all three backend services
JWT_SECRET=ecommerce-secret
JWT_ALGORITHM=HS256

# Shared secret between Customer Service and AI Service
INTERNAL_SERVICE_TOKEN=customer-internal-token
ECOMMERCE_BASE_URL=http://127.0.0.1:8001/api/v1

API_HOST=127.0.0.1
API_PORT=8002

# ----- Answer engine -----
# auto  : use the LLM agent when a model is configured below, otherwise the built-in rule engine
# rules : always use the built-in rule engine (never calls a model)
AGENT_ENGINE=auto

# ----- LLM (leave LLM_API_KEY empty to run without a model) -----
# DeepSeek
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Qwen (DashScope, OpenAI compatible)
# LLM_PROVIDER=qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=

# Ollama (runs on this machine, no key needed; pick a model that supports tool calling)
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b

# Any other OpenAI compatible endpoint
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_MODEL=your-model
# LLM_API_KEY=

LLM_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=30

# ----- Optional: embeddings for hybrid knowledge retrieval (OpenAI compatible /embeddings) -----
# Leave empty to use keyword retrieval only.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
