# ===== Customer Service (port 8000) =====
# Default: zero-dependency local mode (SQLite file + in-process event bus)
DATABASE_URL=sqlite+aiosqlite:///./data/customer_service.db
# Leave REDIS_URL empty to use the in-process event bus
REDIS_URL=

# Standard stack: PostgreSQL + Redis Pub/Sub (start-docker.bat injects these automatically)
# DATABASE_URL=postgresql+psycopg://customer_service:customer_service@127.0.0.1:5432/customer_service
# REDIS_URL=redis://127.0.0.1:6379/0

# Must be identical in all three backend services
JWT_SECRET=ecommerce-secret
JWT_ALGORITHM=HS256

# Shared secret between Customer Service and AI Service
INTERNAL_SERVICE_TOKEN=customer-internal-token
AI_SERVICE_URL=http://127.0.0.1:8002
AI_TIMEOUT_SECONDS=75

API_HOST=127.0.0.1
API_PORT=8000

# Wait this long to merge consecutive user messages into one AI turn
MESSAGE_MERGE_DELAY_MS=1000
# An idle AI conversation is closed after this many minutes; the next message opens a new one
CONVERSATION_IDLE_TIMEOUT_MINUTES=30
